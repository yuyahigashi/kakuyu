---
import '../styles/global.css';
interface Props { title?: string; description?: string; language?: 'ja' | 'en'; alternateHref?: string; image?: string; type?: 'website' | 'article'; }
const { title = 'KAKUYU', description = 'An independent review looking at the world through Japan.', language = 'en', alternateHref, image, type = 'website' } = Astro.props;
const pageTitle = title === 'KAKUYU' ? 'KAKUYU — Independent Review from Japan' : `${title} — KAKUYU`;
const isJapanese = language === 'ja';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateURL = alternateHref ? new URL(alternateHref, Astro.site) : undefined;
const socialImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalURL} />
    {alternateURL && <link rel="alternate" hreflang={isJapanese ? 'en' : 'ja'} href={alternateURL} />}
    {alternateURL && <link rel="alternate" hreflang={language} href={canonicalURL} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="KAKUYU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={isJapanese ? 'ja_JP' : 'en_US'} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="utility"><span>Independent review from Japan</span><div><a href="#newsletter">Newsletter</a><a href={alternateHref ?? (isJapanese ? '/' : '/ja/')} lang={isJapanese ? 'en' : 'ja'}>{isJapanese ? 'English' : '日本語'}</a></div></div>
      <a class="masthead" href={isJapanese ? '/ja/' : '/'}>KAKUYU</a>
      <nav aria-label={isJapanese ? '主要ナビゲーション' : 'Primary navigation'}>
        <a href="/#stories">Stories</a><a href="/section/japan/">Japan</a><a href="/section/world/">World</a><a href="/section/arts/">Arts</a><a href="/section/notebook/">Notebook</a><a href="/#themes">Themes</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div><strong>KAKUYU</strong><p>{isJapanese ? '日本をレンズに、戦争、貧困、孤独、芸術、工芸、記憶、場所、仕事、そして人間の条件を語る。' : 'Looking through Japan at war, poverty, solitude, art, craft, memory, place, work, and the human condition.'}</p></div>
      <div class="footer-links"><a href={isJapanese ? '/ja/about/' : '/about/'}>{isJapanese ? 'KAKUYUについて' : 'About'}</a><a href="mailto:editor@example.com">Contact</a><a href="#newsletter">Newsletter</a></div>
      <small>© {new Date().getFullYear()} KAKUYU</small>
    </footer>
  </body>
</html>
