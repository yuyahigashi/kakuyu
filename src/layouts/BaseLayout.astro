---
import '../styles/global.css';
interface Props { title?: string; description?: string; language?: 'ja' | 'en'; alternateHref?: string; image?: string; type?: 'website' | 'article'; publishedAt?: Date; author?: string; }
const { title = 'KAKUYU', description = 'An independent review looking at the world through Japan.', language = 'en', alternateHref, image, type = 'website', publishedAt, author } = Astro.props;
const isJapanese = language === 'ja';
const pageTitle = title === 'KAKUYU' ? (isJapanese ? 'KAKUYU — 日本から届ける独立系メディア' : 'KAKUYU — Independent Review from Japan') : `${title} — KAKUYU`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateURL = alternateHref ? new URL(alternateHref, Astro.site) : undefined;
const socialImage = image ? new URL(image, Astro.site) : undefined;
const structuredData = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: language,
  mainEntityOfPage: canonicalURL.href,
  datePublished: publishedAt?.toISOString(),
  author: { '@type': 'Organization', name: author ?? 'KAKUYU Editorial Team' },
  publisher: { '@type': 'Organization', name: 'KAKUYU', url: 'https://kakuyu.com/' },
  ...(socialImage ? { image: socialImage.href } : {}),
} : {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'KAKUYU',
  url: canonicalURL.href,
  inLanguage: language,
  description,
};
const structuredDataJSON = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalURL} />
    {alternateURL && <link rel="alternate" hreflang={isJapanese ? 'en' : 'ja'} href={alternateURL} />}
    {alternateURL && <link rel="alternate" hreflang={language} href={canonicalURL} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="KAKUYU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={isJapanese ? 'ja_JP' : 'en_US'} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script is:inline type="application/ld+json" set:html={structuredDataJSON} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="utility"><span>{isJapanese ? '日本から届ける独立系メディア' : 'Independent review from Japan'}</span><div><a href="#newsletter">{isJapanese ? 'ニュースレター' : 'Newsletter'}</a><a href={alternateHref ?? (isJapanese ? '/' : '/ja/')} lang={isJapanese ? 'en' : 'ja'}>{isJapanese ? 'English' : '日本語'}</a></div></div>
      <a class="masthead" href={isJapanese ? '/ja/' : '/'}>KAKUYU</a>
      <nav aria-label={isJapanese ? '主要ナビゲーション' : 'Primary navigation'}>
        <a href={isJapanese ? '/ja/#stories' : '/#stories'}>{isJapanese ? '記事' : 'Stories'}</a><a href={isJapanese ? '/ja/section/japan/' : '/section/japan/'}>{isJapanese ? '日本' : 'Japan'}</a><a href={isJapanese ? '/ja/section/world/' : '/section/world/'}>{isJapanese ? '世界' : 'World'}</a><a href={isJapanese ? '/ja/section/arts/' : '/section/arts/'}>{isJapanese ? '芸術' : 'Arts'}</a><a href={isJapanese ? '/ja/section/notebook/' : '/section/notebook/'}>{isJapanese ? 'ノート' : 'Notebook'}</a><a href={isJapanese ? '/ja/#themes' : '/#themes'}>{isJapanese ? 'テーマ' : 'Themes'}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div><strong>KAKUYU</strong><p>{isJapanese ? '日本をレンズに、戦争、貧困、孤独、芸術、工芸、記憶、場所、仕事、そして人間の条件を語る。' : 'Looking through Japan at war, poverty, solitude, art, craft, memory, place, work, and the human condition.'}</p></div>
      <div class="footer-links"><a href={isJapanese ? '/ja/about/' : '/about/'}>{isJapanese ? 'KAKUYUについて' : 'About'}</a><a href="mailto:editor@example.com">{isJapanese ? 'お問い合わせ' : 'Contact'}</a><a href="#newsletter">{isJapanese ? 'ニュースレター' : 'Newsletter'}</a></div>
      <small>© {new Date().getFullYear()} KAKUYU</small>
    </footer>
  </body>
</html>
