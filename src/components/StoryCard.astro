---
const { story, index = 0, language = 'en' } = Astro.props;
const { title, dek, author, section, publishedAt, image, imageAlt, imagePosition } = story.data;
const date = new Intl.DateTimeFormat(language === 'ja' ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(publishedAt);
---
<article class="story-card">
  <a class:list={['story-image', `tone-${index % 4}`]} href={`/stories/${story.id}/`}>
    {image ? <img src={image} alt={imageAlt ?? ''} loading="lazy" style={imagePosition ? `object-position: ${imagePosition}` : undefined} /> : <span>{String(index + 1).padStart(2, '0')}</span>}
  </a>
  <p class="kicker">{section}</p>
  <h3><a href={`/stories/${story.id}/`}>{title}</a></h3>
  <p>{dek}</p><small>{author} · {date}</small>
</article>
